{
  "name": "migrate-mcp",
  "version": "0.0.1",
  "description": "Safe database migration workflows for MCP clients.",
  "license": "MIT",
  "author": "Royal Pinto <royalpinto007@gmail.com>",
  "homepage": "https://github.com/royalpinto007/migrate-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalpinto007/migrate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/royalpinto007/migrate-mcp/issues"
  },
  "keywords": [
    "mcp",
    "database",
    "migration",
    "alembic",
    "prisma",
    "typeorm",
    "sequelize",
    "golang-migrate"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "migrate-mcp": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "pack:check": "npm run build && npm pack --dry-run && publint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run pack:check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.6.2",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
